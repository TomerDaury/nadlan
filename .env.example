# Environment variables — see spec/ARCHITECTURE.md §2.9.
# Copy to .env and fill in Development values only. Never commit real values.
# Production values live only in Vercel → Settings → Environment Variables.

# --- Supabase (Milestone 2) ---
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Public (publishable) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server only
SUPABASE_SECRET_KEY=
# Connection string for migrations (Session Pooler, port 5432) — local only, not in Vercel Preview
SUPABASE_DB_URL=

# --- Claude API (Milestone 3) ---
ANTHROPIC_API_KEY=

# --- Email via Resend (Milestone 5) ---
RESEND_API_KEY=
# Sender address, e.g. "שם העסק <noreply@example.co.il>"
EMAIL_FROM=
# Development only: send every email to this test address instead of the real recipient
EMAIL_TEST_RECIPIENT=

# --- Personal links (Milestone 5, ADR-15) ---
# Random secret, at least 32 characters. Different in Development and Production. Changing it breaks all existing links.
LINK_TOKEN_SECRET=

# --- App ---
# Base URL for links in emails (local: http://localhost:3000)
APP_BASE_URL=

# --- Cron (Milestone 5) ---
# Random secret. Needed locally too, to call /api/cron/email-outbox by hand.
CRON_SECRET=
